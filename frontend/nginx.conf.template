server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # префикс /api срезается, бэкенд его не знает
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
